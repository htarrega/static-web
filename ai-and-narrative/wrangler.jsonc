// Worker that gates htarrega.me/ai-and-narrative/* behind a password.
// The rest of htarrega.me keeps being served by GitHub Pages.
// See DESIGN.md for the reasoning.
{
  "name": "ai-and-narrative",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "htarrega.me/ai-and-narrative*", "zone_name": "htarrega.me" }
  ],
  // Failed-login counters per IP (see MAX_FAILS in worker.js).
  "kv_namespaces": [
    { "binding": "RL", "id": "330d2773cb7b4254a6477803a270f7f6" }
  ],
  // Stats storage. Hugo creates it once with `wrangler d1 create ai-and-narrative-stats`
  // and pastes the printed database_id here (see DESIGN.md, "Stats panel").
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-and-narrative-stats", "database_id": "cf54a771-23a5-4ea9-b5fb-ed3c848116bf" }
  ],
  "vars": {
    // Comma-separated password names: their visits are not recorded and they may open the stats panel.
    "OWNER_NAMES": "hugo",
    // Update when publishing a session (id + publication day, Europe/Madrid).
    "SESSIONS": "[{\"id\":1,\"published\":\"2026-11-21\"},{\"id\":2,\"published\":\"2026-11-25\"}]"
  },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // The Worker checks the cookie before any asset is served.
    "run_worker_first": true,
    // Serve files exactly as named; the Worker maps "/" to index.html.
    "html_handling": "none",
    "not_found_handling": "none"
  }
  // Secret (not in this file): ACCESS — the list of valid passwords (hashed).
  // Manage it ONLY with ./access.mjs, which also writes .dev.vars for local dev.
}
